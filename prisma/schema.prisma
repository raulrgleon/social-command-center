generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  APPROVER
  VIEWER
}

enum AccountStatus {
  DEMO
  CONNECTED
  EXPIRED
  NEEDS_REAUTH
  DISCONNECTED
  INSUFFICIENT_PERMISSIONS
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIAL
  FAILED
  ARCHIVED
}

enum PostSource {
  MANUAL
  AI
  URL
  TEMPLATE
  DUPLICATE
}

enum OperationStatus {
  PENDING
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  NEEDS_AUTH
  MANUAL_REQUIRED
  NOT_COMPATIBLE
  CANCELLED
}

enum ResultSource {
  LOCAL
  EXTERNAL_SYNC
}

enum MetricAvailability {
  AVAILABLE
  UNAVAILABLE
  PENDING_SYNC
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  timezone     String        @default("America/Bogota")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  WorkspaceMember[]
  sessions     AuthSession[]
  posts        Post[]
  auditLogs    AuditLog[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String   @default("")

  @@index([userId])
}

model Workspace {
  id          String                 @id @default(cuid())
  name        String
  slug        String                 @unique
  isDemo      Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  members     WorkspaceMember[]
  brands      Brand[]
  accounts    ConnectedAccount[]
  posts       Post[]
  templates   Template[]
  campaigns   Campaign[]
  aiConfig    AiConfig?
  media       MediaAsset[]
  auditLogs   AuditLog[]
  oauthStates OauthState[]
  prefs       WorkspacePlatformPref[]
  externals   ExternalPost[]
  operations  PublishOperation[]
  metrics     MetricSnapshot[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        MemberRole @default(EDITOR)
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

model WorkspacePlatformPref {
  workspaceId String
  platformId  String
  visible     Boolean   @default(true)
  sortOrder   Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, platformId])
}

model Brand {
  id          String             @id @default(cuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  voice       String             @default("")
  color       String             @default("#0f6e62")
  createdAt   DateTime           @default(now())
  posts       Post[]
  campaigns   Campaign[]
  accounts    ConnectedAccount[]
}

model ConnectedAccount {
  id             String             @id @default(cuid())
  workspaceId    String
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformId     String
  brandId        String?
  brand          Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  displayName    String
  handle         String             @default("")
  externalId     String?
  status         AccountStatus
  isDemo         Boolean            @default(false)
  canRead        Boolean            @default(false)
  canPublish     Boolean            @default(false)
  canSchedule    Boolean            @default(false)
  canMetrics     Boolean            @default(false)
  contentTypes   String[]
  tokenCipher    String?
  tokenIv        String?
  tokenTag       String?
  tokenExpiresAt DateTime?
  scopes         String[]
  lastSyncAt     DateTime?
  lastSyncError  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  operations     PublishOperation[]
  metrics        MetricSnapshot[]
  externals      ExternalPost[]

  @@index([workspaceId, platformId])
}

model Campaign {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandId     String?
  brand       Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name        String
  description String    @default("")
  startsOn    DateTime?
  endsOn      DateTime?
  createdAt   DateTime  @default(now())
  posts       Post[]
}

model Post {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandId     String?
  brand       Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaignId  String?
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title       String        @default("")
  masterBody  String        @default("")
  linkUrl     String        @default("")
  status      PostStatus    @default(DRAFT)
  source      PostSource    @default(MANUAL)
  tone        String        @default("informativo")
  isDemo      Boolean       @default(false)
  plannedFor  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  versions    PostVersion[]
  media       PostMedia[]
  operations  PublishOperation[]

  @@index([workspaceId, status])
  @@index([workspaceId, plannedFor])
}

model PostVersion {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platformId String
  title      String   @default("")
  body       String   @default("")
  hashtags   String[]
  linkUrl    String   @default("")
  customized Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  operations PublishOperation[]

  @@unique([postId, platformId])
}

model MediaAsset {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        MediaKind
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  createdAt   DateTime  @default(now())
  posts       PostMedia[]
}

model PostMedia {
  postId  String
  mediaId String
  order   Int        @default(0)
  post    Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
}

model PublishOperation {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postId         String
  post           Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  versionId      String?
  version        PostVersion?    @relation(fields: [versionId], references: [id], onDelete: SetNull)
  accountId      String
  account        ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  platformId     String
  idempotencyKey String          @unique
  status         OperationStatus
  scheduledFor   DateTime?
  attemptedAt    DateTime?
  completedAt    DateTime?
  externalId     String?
  externalUrl    String?
  errorCode      String?
  errorMessage   String?
  attemptCount   Int             @default(0)
  resultSource   ResultSource    @default(LOCAL)
  isDemo         Boolean         @default(false)
  retryable      Boolean         @default(false)
  lockedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, scheduledFor])
  @@index([workspaceId, platformId, completedAt])
  @@index([postId, accountId])
}

model ExternalPost {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  account     ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platformId  String
  externalId  String
  publishedAt DateTime
  text        String           @default("")
  permalink   String           @default("")
  createdAt   DateTime         @default(now())

  @@unique([accountId, externalId])
  @@index([workspaceId, publishedAt])
}

model MetricSnapshot {
  id           String             @id @default(cuid())
  workspaceId  String
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId    String
  account      ConnectedAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  operationId  String?
  platformId   String
  capturedAt   DateTime           @default(now())
  availability MetricAvailability
  reach        Int?
  impressions  Int?
  interactions Int?
  note         String             @default("")

  @@index([workspaceId, capturedAt])
}

model Template {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  masterBody  String
  tone        String    @default("informativo")
  versions    Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AiConfig {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String    @default("none")
  model       String    @default("gpt-4o-mini")
  baseUrl     String    @default("")
  keyCipher   String?
  keyIv       String?
  keyTag      String?
  updatedAt   DateTime  @updatedAt
}

model OauthState {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformId   String
  stateHash    String    @unique
  codeVerifier String    @default("")
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id          String     @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  metadata    Json
  createdAt   DateTime   @default(now())

  @@index([workspaceId, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model PageView {
  id    String   @id @default(cuid())
  path  String
  day   DateTime @db.Date
  count Int      @default(0)

  @@unique([path, day])
}
